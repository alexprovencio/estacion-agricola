// Copiar a secrets.h y rellenar con la configuración real.

// Canal WiFi (2.4 GHz) en el que se comunican nodo y puente.
// Debe coincidir con el canal que use el nodo en su firmware.
#define ESP_NOW_CHANNEL 6

// MAC del nodo autónomo.
// Para averiguarla, imprimirla desde el nodo (WiFi.macAddress()) o leerla en
// el monitor serie USB del puente al recibir (info->src_addr).
const uint8_t NODE_MAC[6] = {0x00, 0x00, 0x00, 0x00, 0x00, 0x00};
